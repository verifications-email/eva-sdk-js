{
  "name": "@eva-email/sdk",
  "version": "0.1.0",
  "description": "Official JavaScript/TypeScript SDK for the EVA Email Verification API",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "email",
    "verification",
    "validation",
    "api",
    "sdk",
    "eva",
    "email-validation",
    "email-verification",
    "disposable-email",
    "smtp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/verifications-email/eva-sdk-js"
  },
  "homepage": "https://verifications.email",
  "bugs": {
    "url": "https://github.com/verifications-email/eva-sdk-js/issues"
  }
}
